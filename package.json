{
  "name": "@dariuss/valenced-plugins",
  "version": "1.0.0-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "valenced-plugin build",
    "build:dev": "valenced-plugin build --dev",
    "generate-index": "valenced-plugin generate-index",
    "plan-releases": "valenced-plugin plan-releases --plugins-dir plugins --plugins-dir themes",
    "serve": "valenced-plugin serve",
    "lint": "biome check",
    "lint:types": "tsc -p plugins/QT/tsconfig.json --noEmit && tsc -p plugins/JTP/tsconfig.json --noEmit && tsc -p plugins/SHC/tsconfig.json --noEmit && tsc -p plugins/VMTT/tsconfig.json --noEmit && tsc -p themes/MT/tsconfig.json --noEmit && tsc -p plugins/AML/tsconfig.json --noEmit && tsc -p plugins/GPL/tsconfig.json --noEmit && tsc -p plugins/NTM/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.cjs themes/MT/tests/*.test.cjs",
    "publish:local": "node scripts/publish.mjs",
    "pretest": "npm run build:all",
    "build:all": "valenced-plugin build --plugins-dir plugins --plugins-dir themes"
  },
  "dependencies": {
    "@valenced/plugin-cli": "git+https://github.com/Valenced/valenced-plugin-cli.git#9ea9f9bfc91319e2b18c6b1c9ac0b993f8600c1d",
    "@valenced/types": "git+https://github.com/Valenced/valenced-types.git#c67dd726d1ec28b38d8ac93862fdd3b6029b1d29",
    "@valenced/themes-api": "git+https://github.com/Valenced/valenced-themes-types.git#f329610cc80004417564c8058249b957631b32b0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.9.0",
    "yoga-layout": "3.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "@valenced/plugin-cli",
    "@swc/core"
  ]
}
